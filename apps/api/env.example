# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/your-database-name

# MongoDB Connection Pool Configuration
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SOCKET_TIMEOUT_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=30000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=400

# Better Auth (required)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5001
WEB_URL=http://localhost:3000

# Google OAuth (optional — enable Google login when both are set)
# Authorized redirect URI: http://localhost:5001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (required for email verification)
# https://resend.com/api-keys — use an address on your verified domain
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=AskDocs <ayush@ayushdixit.me>
