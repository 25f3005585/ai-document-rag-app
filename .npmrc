# Fail installs when Node version doesn't match package.json engines
engine-strict=true

# Hoist ESLint/Prettier so monorepo tooling can resolve them from the root
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
# Hoist Tailwind so PostCSS can resolve `@import 'tailwindcss'` from packages/ui CSS
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*@tailwindcss*
